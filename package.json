{
  "name": "positionguard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "verify:network": "node --import tsx scripts/verify-network.ts",
    "verify:env": "node --import tsx scripts/verify-env.ts",
    "verify:rpc": "node --import tsx scripts/verify-rpc.ts",
    "verify:aave": "node --import tsx scripts/verify-network.ts",
    "verify:keeperhub": "node --conditions=react-server --import tsx scripts/verify-keeperhub.ts",
    "verify:allowance": "node --conditions=react-server --import tsx scripts/verify-allowance.ts",
    "verify:db": "node --conditions=react-server --import tsx scripts/verify-database.ts",
    "verify:autonomous": "node --conditions=react-server --import tsx scripts/verify-autonomous-operations.ts",
    "db:migrate:safe": "node --import tsx scripts/migrate-database.ts",
    "worker:monitor": "node --conditions=react-server --import tsx scripts/monitor-worker.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "17.4.2",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "viem": "2.56.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <26"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
