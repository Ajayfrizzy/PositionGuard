# Required server-only PostgreSQL URL. Supply it locally; do not commit credentials.
DATABASE_URL=
# Development-only escape hatch for a trusted local TLS interceptor or self-signed database CA.
# Prefer installing the CA and leave this false in production.
DATABASE_TLS_ALLOW_SELF_SIGNED=false

# Required for server-side Base Sepolia reads; no public/browser RPC secret.
BASE_SEPOLIA_RPC_URL=
# Optional Base mainnet RPC for production/mainnet reads.
BASE_RPC_URL=
POSITIONGUARD_DEFAULT_CHAIN_ID=84532
# At least 32 random characters for operator/development endpoints and scenario grants. Never NEXT_PUBLIC.
POSITIONGUARD_DEV_TOKEN=
# Separate 32+ character server-side step-up secret for the operator HTTP broadcast path.
POSITIONGUARD_BROADCAST_TOKEN=

# CLI wallet selection, not a secret; may also be passed as verify:aave argument.
AAVE_WALLET_ADDRESS=
# Organization (kh_) key. Simulation/broadcast capability must match the selected execution mode.
KEEPERHUB_API_KEY=
# Optional; only the official HTTPS origin is accepted.
KEEPERHUB_BASE_URL=https://app.keeperhub.com
# Expected sender pin for funding, allowance, simulation, and execution verification.
KEEPERHUB_EXECUTION_WALLET=
MONITOR_POLL_INTERVAL_MS=60000
# Optional logical worker identity. It must match in the web and worker processes.
WORKER_NAME=monitoring
# Optional deployment namespace. Defaults to development locally and production in Docker.
WORKER_ENVIRONMENT=
# Optional persisted-notification webhook. Use a long random signing secret in hosted environments.
POSITIONGUARD_WEBHOOK_URL=
POSITIONGUARD_WEBHOOK_SECRET=
# Optional worker heartbeat path used by the Docker health check.
WORKER_HEARTBEAT_PATH=
